# Dependencies & build output (installed/generated inside the image)
node_modules
.next
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Never bake secrets or local env into an image
.env
.env.*
!.env.example

# VCS & editor noise
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.log
npm-debug.log*

