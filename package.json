{
  "name": "capgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:seo": "node scripts/seo-check.mjs",
    "test:smoke": "node scripts/test-app.mjs",
    "test:contracts": "node --test scripts/plan-contract.test.mjs",
    "test:refinement": "node scripts/refinement-check.mjs",
