    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.63.0",
    "postcss": "^8.5",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
